# Copy to `.env` and fill in. `.env` is git-ignored - never commit real values.

# --- LLM (Azure OpenAI chat completions) ---------------------------------------
# Full chat-completions URL of your deployment, including the api-version query string
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/deployments/<your-deployment>/chat/completions?api-version=2024-02-15-preview
AZURE_OPENAI_API_KEY=<your-api-key>

# --- PLC (S7-1500 via Snap7, ISO-on-TCP port 102) -------------------------------
PLC_IP=192.168.0.1
PLC_RACK=0
PLC_SLOT=1

# --- Robot arms (uArm Swift Pro, USB serial) ----------------------------------
ARM1_PORT=COM3
ARM2_PORT=COM5
ARM3_PORT=COM4

# --- TIA Portal Openness (optional, Windows) -----------------------------------
TIA_PROJECT_PATH=C:\path\to\your\project.ap19
TIA_VERSION=V19
TIA_OPENNESS_PATH=C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19
# Set to 1 to skip TIA Openness entirely (Snap7-only mode)
TIA_OPENNESS_DISABLED=0

# --- Runtime ------------------------------------------------------------------
# Folder for the shared JSON state files (defaults to ./data)
# COPILOT_DATA_DIR=./data
# Browser origins allowed to call the APIs
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
